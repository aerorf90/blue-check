# Website service (Render Environment)
NODE_ENV=production
TRUST_PROXY=1
ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET_IN_RENDER
SESSION_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET_IN_RENDER
# Required by this codebase for the main website service. Use a MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/...
MONGODB_DATABASE=pccheck
BASE_URL=https://YOUR-SITE-SERVICE.onrender.com
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_SECRET
RETENTION_DAYS=30
MAX_ACTIVE_CODES=3
# Optional:
DOWNLOAD_URL=https://YOUR_DOWNLOAD_HOST/client.zip
CONTACT_EMAIL=you@example.com

# Separate owner-report service (set in its own Render service, not the website service)
# DATABASE_URL is supplied from the Render PostgreSQL database blueprint resource.
OWNER_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
# That service also needs its own unique SESSION_SECRET and KEY_PEPPER (Render can generate these).
